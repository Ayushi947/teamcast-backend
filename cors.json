[
  {
    "maxAgeSeconds": 3600,
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE", "OPTIONS"],
    "origin": [
      "https://*.teamcast.ai",
      "http://*.teamcast.ai",
      "https://localhost:*",
      "http://localhost:*"
    ],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "x-goog-resumable",
      "x-goog-content-length-range",
      "x-goog-meta-*",
      "Access-Control-Allow-Origin",
      "Access-Control-Allow-Methods",
      "Access-Control-Allow-Headers",
      "Access-Control-Expose-Headers",
      "Cache-Control",
      "Content-Disposition",
      "Content-Encoding",
      "Content-Length",
      "Content-Range",
      "Range",
      "Accept-Ranges",
      "Date",
      "ETag",
      "Expires",
      "Last-Modified"
    ]
  }
]

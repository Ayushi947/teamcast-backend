enum resume_parsing_task_status {
  PENDING
  PROCESSING
  UPDATING_CANDIDATE_RESUME
  COMPLETED
  FAILED
}

model resume_parsing_task {
  id        String                     @id @default(uuid())
  resume    resume                     @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId  String                     @unique
  status    resume_parsing_task_status @default(PENDING)
  error     String?
  fileUrl   String
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@map("resume_parsing_tasks")
}

model resume_public_parsing_task {
  id        String                     @id @default(uuid())
  status    resume_parsing_task_status @default(PENDING)
  error     String?
  fileUrl   String
  fileName  String
  mode      String                     @default("INFERRED")
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@map("resume_public_parsing_tasks")
}

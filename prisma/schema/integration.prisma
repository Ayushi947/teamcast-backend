// Integration Framework Models

// Integration provider types
enum integration_provider_type {
  JOB_BOARD
  ATS
}

// Integration status
enum integration_status {
  ACTIVE
  INACTIVE
  ERROR
  SYNCING
}

// Integration sync status
enum integration_sync_status {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
}

// Job posting integration status
enum job_posting_integration_status {
  DRAFT
  PUBLISHED
  SYNCED
  FAILED
  DELETED
}

// Candidate source tracking
enum candidate_source {
  SELF_SIGNUP
  JOB_BOARD_IMPORT
  ATS_IMPORT
  MANUAL_IMPORT
  REFERRAL
}

// Integration provider model
model integration_provider {
  id          String                    @id @default(uuid())
  name        String                    @unique
  type        integration_provider_type
  description String?
  logoUrl     String?
  websiteUrl  String?

  // API configuration
  apiEndpoint String?
  apiVersion  String?
  authType    String? // "oauth", "api_key", "basic"
  authConfig  Json? // Provider-specific authentication configuration

  // Feature flags
  supportsJobImport       Boolean @default(false)
  supportsJobPublish      Boolean @default(false)
  supportsCandidateImport Boolean @default(false)
  supportsCandidatePush   Boolean @default(false)
  supportsPipelineUpdate  Boolean @default(false)

  // Rate limiting
  rateLimitPerMinute Int?
  rateLimitPerHour   Int?

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Metadata
  metadata Json?

  // Relations
  clientIntegrations client_integration[]
  jobInvites         job_invite[] // Job invites created through this integration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("integration_providers")
}

// Client integration model
model client_integration {
  id       String @id @default(uuid())
  client   client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  provider   integration_provider @relation(fields: [providerId], references: [id])
  providerId String

  // Integration configuration
  name        String
  description String?
  status      integration_status @default(INACTIVE)

  // Authentication credentials (encrypted)
  credentials Json? // Encrypted provider-specific credentials

  // Configuration settings
  config Json? // Provider-specific configuration

  // Sync settings
  autoSyncEnabled Boolean   @default(false)
  syncInterval    Int? // Minutes between syncs
  lastSyncAt      DateTime?
  nextSyncAt      DateTime?

  // Error tracking
  lastError   String?
  lastErrorAt DateTime?
  errorCount  Int       @default(0)

  // Relations
  jobPostingIntegrations job_posting_integration[]
  integrationSyncTasks   integration_sync_task[]
  webhooks               integration_webhook[]
  auditLogs              integration_audit_log[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, providerId])
  @@index([status])
  @@index([autoSyncEnabled])
  @@index([lastSyncAt])
  @@map("client_integrations")
}

// Job posting integration model
model job_posting_integration {
  id String @id @default(uuid())

  // Relations
  jobPosting   job_posting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobPostingId String

  clientIntegration   client_integration @relation(fields: [clientIntegrationId], references: [id], onDelete: Cascade)
  clientIntegrationId String

  // External job reference
  externalJobId   String? // ID from the external platform
  externalJobUrl  String? // URL to the job on external platform
  externalJobData Json? // Raw data from external platform

  // Integration status
  status job_posting_integration_status @default(DRAFT)

  // Sync information
  lastSyncedAt DateTime?
  syncStatus   integration_sync_status?
  syncError    String?

  // Publishing information
  publishedAt DateTime?
  publishedBy String? // User ID who published

  // Relations
  candidateIntegrations candidate_integration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobPostingId, clientIntegrationId])
  @@index([status])
  @@index([externalJobId])
  @@index([lastSyncedAt])
  @@map("job_posting_integrations")
}

// Candidate integration model
model candidate_integration {
  id String @id @default(uuid())

  // Relations
  candidate   candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  jobPostingIntegration   job_posting_integration @relation(fields: [jobPostingIntegrationId], references: [id], onDelete: Cascade)
  jobPostingIntegrationId String

  // External candidate reference
  externalCandidateId   String? // ID from the external platform
  externalApplicationId String? // Application ID from external platform
  externalCandidateData Json? // Raw data from external platform

  // Source tracking
  source candidate_source

  // Sync information
  lastSyncedAt DateTime?
  syncStatus   integration_sync_status?
  syncError    String?

  // Pipeline information (for ATS)
  pipelineStage   String?
  pipelineStageId String?
  pipelineData    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, jobPostingIntegrationId])
  @@index([source])
  @@index([externalCandidateId])
  @@index([externalApplicationId])
  @@index([lastSyncedAt])
  @@map("candidate_integrations")
}

// Integration sync task model
model integration_sync_task {
  id String @id @default(uuid())

  // Relations
  clientIntegration   client_integration @relation(fields: [clientIntegrationId], references: [id], onDelete: Cascade)
  clientIntegrationId String

  // Task information
  taskType String // "job_import", "job_publish", "candidate_import", "candidate_push", "pipeline_update"
  status   integration_sync_status @default(PENDING)

  // Task data
  requestData  Json? // Input data for the task
  responseData Json? // Output data from the task
  errorData    Json? // Error information if failed

  // Progress tracking
  progress       Int  @default(0) // Percentage complete (0-100)
  totalItems     Int?
  processedItems Int  @default(0)

  // Timing
  startedAt           DateTime?
  completedAt         DateTime?
  estimatedCompletion DateTime?

  // Retry logic
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  nextRetryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([taskType])
  @@index([startedAt])
  @@index([completedAt])
  @@map("integration_sync_tasks")
}

// Integration webhook model (for receiving updates from external platforms)
model integration_webhook {
  id String @id @default(uuid())

  // Relations
  clientIntegration   client_integration @relation(fields: [clientIntegrationId], references: [id], onDelete: Cascade)
  clientIntegrationId String

  // Webhook configuration
  endpoint String
  secret   String? // Webhook secret for verification
  events   String[] // Events to listen for

  // Status
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?

  // Statistics
  totalTriggers      Int @default(0)
  successfulTriggers Int @default(0)
  failedTriggers     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([lastTriggeredAt])
  @@map("integration_webhooks")
}

// Integration audit log model
model integration_audit_log {
  id String @id @default(uuid())

  // Relations
  clientIntegration   client_integration @relation(fields: [clientIntegrationId], references: [id], onDelete: Cascade)
  clientIntegrationId String

  // Audit information
  action     String // "create", "update", "delete", "sync", "error"
  entityType String // "job", "candidate", "integration"
  entityId   String?

  // Data
  oldData  Json?
  newData  Json?
  metadata Json?

  // User tracking
  performedBy String? // User ID who performed the action

  createdAt DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([performedBy])
  @@index([createdAt])
  @@map("integration_audit_logs")
}

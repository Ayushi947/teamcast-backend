enum rag_task_cron_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model rag_task_cron {
  id                String               @id @default(uuid())
  status            rag_task_cron_status @default(PENDING)
  totalEntities     Int                  @default(0)
  processedEntities Int                  @default(0)
  failedEntities    Int                  @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  error             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("rag_task_crons")
}

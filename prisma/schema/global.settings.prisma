  maxSections            Int @default(5)
  maxQuestionsPerSection Int @default(5)

  // Proctoring configuration
  proctoringEnabled Boolean @default(true)
  maxWarnings       Int     @default(3) // Maximum warnings before automatic failure
  tabSwitchLimit    Int     @default(3) // Number of tab switches allowed
  copyPasteAllowed  Boolean @default(false)

  // Video analysis configuration
  videoRecordingEnabled  Boolean @default(true)
  minimumVideoLength     Int     @default(300) // Minimum video length in seconds
  aiVideoAnalysisEnabled Boolean @default(true)

  // Automatic actions
  autoPublishOnSuccess Boolean @default(false) // Auto-publish result on passing
  autoNotifyOnComplete Boolean @default(true) // Auto-notify candidate on completion

  // Voice configuration
  interviewLanguage    String? // Primary language for interviews (e.g., "ENGLISH")
  interviewDialect     String? // Dialect code for voice synthesis (e.g., "en-US", "en-GB", "en-AU", "en-CA", "en-IN")
  interviewVoiceGender String? // Voice gender: "female" or "male"

  // Section templates (stored as JSON)
  sectionTemplates  Json? // Predefined section templates
  questionTemplates Json? // Predefined question templates

  // Customization
  customStyles       Json? // UI customization options
  customInstructions String? // Custom instructions for candidates

  // Related settings
  clientAiAssessmentSettings client_ai_assessment_settings[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_job_ai_assessment_settings")
}


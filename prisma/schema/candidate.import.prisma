// Candidate Import Schema

model candidate_import {
  id           String @id @default(uuid())
  batchId      String // Groups candidates from the same import
  jobPostingId String
  clientId     String

  // Original Excel data
  email      String
  name       String
  phone      String?
  jobTitle   String?
  location   String?
  experience Int? // Years of experience
  skills     String? // Comma-separated skills from Excel
  education  String?
  gender     String?
  languages  String? // Comma-separated languages from Excel

  // Import metadata
  originalFileName String
  storedFileName   String
  fileUrl          String
  uploadedBy       String
  uploadCount      Int    @default(1) // Track how many times this client has uploaded files

  // Processing status
  status           candidate_import_status @default(PENDING)
  isDuplicate      Boolean                 @default(false)
  duplicateScore   Float? // Fuzzy match score (0.0-1.0)
  duplicateOf      String? // Reference to original candidate import ID
  validationErrors String? // JSON array of validation errors

  // Integration tracking
  integrationProviderId String? // ID of the integration provider used for import

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobPosting     job_posting @relation("CandidateImports", fields: [jobPostingId], references: [id], onDelete: Cascade)
  client         client      @relation("CandidateImports", fields: [clientId], references: [id], onDelete: Cascade)
  uploadedByUser user        @relation("CandidateImportUploads", fields: [uploadedBy], references: [id], onDelete: Cascade)

  // Relationship to actual candidate (if processed into candidate table)
  candidate   candidate? @relation("CandidateImports", fields: [candidateId], references: [id], onDelete: SetNull)
  candidateId String?

  @@unique([email, jobPostingId], name: "unique_email_per_job")
  @@index([batchId])
  @@index([jobPostingId])
  @@index([clientId])
  @@index([email])
  @@index([status])
  @@index([candidateId])
  @@index([uploadCount])
  @@index([integrationProviderId])
  @@map("candidate_imports")
}

enum candidate_import_status {
  PENDING
  PROCESSED
  INVITED
  REGISTERED
  DUPLICATE
  FAILED
}

enum onboarding_assessment_task_status {
  PENDING
  INITIALIZE_STARTED
  INITIALIZE_COMPLETED
  ASSESSMENT_STARTED
  ASSESSMENT_COMPLETED
  COMPLETED
  FAILED
}

model onboarding_assessment_task {
  id           String                            @id @default(uuid())
  assessment   onboarding_assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String                            @unique
  status       onboarding_assessment_task_status @default(PENDING)
  error        String?
  createdAt    DateTime                          @default(now())
  updatedAt    DateTime                          @updatedAt

  @@map("onboarding_assessment_task")
}

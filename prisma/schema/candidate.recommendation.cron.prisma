// Candidate Recommendation Cron Task Models
enum candidate_recommendation_cron_task_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model candidate_recommendation_cron_task {
  id                     String                                    @id @default(uuid())
  status                 candidate_recommendation_cron_task_status @default(PENDING)
  totalCandidates        Int                                       @default(0)
  processedCandidates    Int                                       @default(0)
  failedCandidates       Int                                       @default(0)
  recommendationsCreated Int                                       @default(0)
  error                  String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  syncTasks candidate_recommendation_sync_task[]

  @@map("candidate_recommendation_cron_tasks")
}

model candidate_recommendation_sync_task {
  id          String                                    @id @default(uuid())
  candidate   candidate                                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  cronTask    candidate_recommendation_cron_task        @relation(fields: [cronTaskId], references: [id], onDelete: Cascade)
  cronTaskId  String
  status      candidate_recommendation_cron_task_status @default(PENDING)

  recommendationsCreated Int     @default(0)
  error                  String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, cronTaskId])
  @@index([cronTaskId])
  @@index([status])
  @@map("candidate_recommendation_sync_tasks")
}

enum practice_assessment_status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum practice_assessment_result {
  NOT_AVAILABLE
  PASSED
  FAILED
}

model practice_assessment {
  id          String    @id @default(uuid())
  candidate   candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  title       String
  description String

  skillsFocus String[]
  difficulty  difficulty_level           @default(MEDIUM)
  status      practice_assessment_status @default(NOT_STARTED)
  result      practice_assessment_result @default(NOT_AVAILABLE)
  score       Float                      @default(0)
  duration    Int                        @default(3600) // in seconds
  startedAt   DateTime?
  completedAt DateTime?

  // Feedback fields
  overallFeedback     String?
  strengths           String[] // Array of overall strengths
  areasForImprovement String[] // Array of overall areas for improvement

  // Credit usage tracking
  usedCredit Boolean @default(false)

  // Relationships
  sections practice_assessment_section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@map("practice_assessments")
}

enum practice_assessment_section_status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum practice_assessment_section_result {
  NOT_AVAILABLE
  PASSED
  FAILED
}

model practice_assessment_section {
  id           String              @id @default(uuid())
  assessment   practice_assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String

  title       String
  description String
  type        String // Section type
  status      practice_assessment_section_status @default(NOT_STARTED)
  result      practice_assessment_section_result @default(NOT_AVAILABLE)
  score       Float                              @default(0)
  order       Int                                @default(0)

  // New feedback fields
  strengths           String[] // New: Array of section-specific strengths
  areasForImprovement String[] // New: Areas that need improvement

  questions practice_assessment_question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId, order])
  @@map("practice_assessment_sections")
}

model practice_assessment_question {
  id        String                      @id @default(uuid())
  section   practice_assessment_section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String

  question      String
  questionType  question_type // MULTIPLE_CHOICE, TEXT, CODE, etc.
  options       Json? // For multiple choice options
  correctAnswer String? // Optional correct answer
  answerGiven   String? // Candidate's answer
  score         Float         @default(0)
  maxScore      Float         @default(1.0)
  order         Int           @default(0)
  isRequired    Boolean       @default(true)

  // Feedback for this specific question
  feedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, order])
  @@map("practice_assessment_questions")
}

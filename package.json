{
  "name": "teamcast-backend",
  "version": "1.0.0",
  "main": "index.ts",
  "license": "MIT",
  "prisma": {
    "schema": "./prisma/schema"
  },
  "scripts": {
    "start": "./scripts/app-start.sh",
    "start:raw": "NODE_OPTIONS='--require=perf_hooks' node --expose-gc --trace-gc --trace-gc-ignore-scavenger dist/src/index.js",
    "dev": "npx nodemon",
    "dev:clean": "rimraf dist && tsx watch src/index.ts",
    "build": "tsc -p . && tsc-alias",
    "pm2:start": "pm2 start pm2.config.js",
    "pm2:start:prod": "pm2 start pm2.config.js --env production",
    "pm2:start:qa": "pm2 start pm2.config.js --env qa",
    "pm2:stop": "pm2 stop teamcast-backend",
    "pm2:restart": "pm2 restart teamcast-backend",
    "pm2:reload": "pm2 reload teamcast-backend",
    "pm2:delete": "pm2 delete teamcast-backend",
    "pm2:logs": "pm2 logs teamcast-backend",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:resurrect": "pm2 resurrect",
    "pm2:deploy": "./scripts/pm2-deploy.sh",
    "pm2:deploy:prod": "./scripts/pm2-deploy.sh production",
    "pm2:deploy:qa": "./scripts/pm2-deploy.sh qa",
    "pm2:startup": "sudo ./scripts/pm2-startup.sh",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down -v",
    "docker:qa": "docker compose -f docker-compose.qa.yml up",
    "docker:qa:build": "docker compose -f docker-compose.qa.yml up --build",
    "docker:qa:down": "docker compose -f docker-compose.qa.yml down -v",
    "seed:local": "ts-node -P tsconfig.scripts.json scripts/local.seed.ts",
    "seed:dev": "ts-node -P tsconfig.scripts.json scripts/dev.seed.ts",
    "seed:excel": "ts-node -P tsconfig.scripts.json scripts/excel-upload-integration.ts",
    "seed:prod": "ts-node -P tsconfig.scripts.json scripts/prod.seed.ts",
    "seed:practice-assessment-settings": "ts-node -P tsconfig.scripts.json scripts/seed-practice-assessment-settings.ts",
    "update:tours": "ts-node -P tsconfig.scripts.json scripts/update-tour-definitions.ts",
    "add:sla": "ts-node -P tsconfig.scripts.json scripts/add-sla-policy.ts",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "migrate:status": "npx prisma migrate status",
    "migrate:reset": "npx prisma migrate reset",
    "migrate:script": "./scripts/db-migrate.sh",
    "db:migrate": "./scripts/db-migrate.sh",
    "db:migrate:fallback": "npx prisma migrate deploy",
    "db:reset": "./scripts/db-migrate.sh --reset",
    "db:status": "./scripts/db-migrate.sh --status",
    "db:validate": "./scripts/db-migrate.sh --validate-only",
    "generate": "npx prisma generate",
    "studio": "npx prisma studio",
    "test": "vitest",
    "test:watch": "jest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "lint": "eslint . --ext .ts",
    "lint:s": "eslint . --ext .ts --quiet",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky",
    "prepare:db": "npm run db:migrate && npm run generate",
    "prepare:db:fallback": "npm run db:migrate:fallback && npm run generate"
  },
  "_moduleAliases": {
    "@": "dist/src"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.24.0",
    "@eslint/json": "^0.11.0",
    "@eslint/markdown": "^6.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/express-rate-limit": "^6.0.2",
    "@types/fuzzyset.js": "^0.0.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/response-time": "^2.3.8",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "prisma": "^6.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.13",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@bull-board/api": "^6.11.0",
    "@bull-board/express": "^6.11.0",
    "@bull-board/ui": "^6.11.0",
    "@faker-js/faker": "^9.7.0",
    "@getbrevo/brevo": "^2.2.0",
    "@google-cloud/speech": "^7.1.0",
    "@google-cloud/storage": "^7.16.0",
    "@google-cloud/text-to-speech": "^6.1.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@google-cloud/video-intelligence": "^6.2.1",
    "@prisma/client": "^6.7.0",
    "@sentry/integrations": "^7.114.0",
    "@sentry/node": "^10.8.0",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.56.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "countries-and-timezones": "^3.8.0",
    "country-state-city": "^3.2.1",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.0.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.13.3",
    "module-alias": "^2.2.3",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "prom-client": "^15.1.3",
    "response-time": "^2.3.3",
    "stripe": "^18.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.1"
  }
}

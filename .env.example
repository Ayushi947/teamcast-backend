# Server
NODE_ENV=development
ENV_NAME=development
PORT=4300
SERVER_URL=http://localhost:4300

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamcast?schema=public"

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Frontend
FRONTEND_URL=http://localhost:3000

# OAuth Configuration
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8081
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=12345
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
OAUTH_REDIRECT_URL=http://localhost:3000
OAUTH_STATE_SECRET=your-secure-random-string-for-jwt-signing-min-32-chars

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Email
EMAIL_FROM=noreply@teamcast.ai
EMAIL_FROM_NAME=Teamcast
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_SECURE=false
SMTP_FROM=no-reply@example.com


# App
APP_NAME="Teamcast Backend"

# Google Cloud Storage
GOOGLE_STORAGE_BUCKET=teamcast-dev-storage
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
PRE_SIGNED_URL_EXPIRY_SECONDS=300

# Cache
CACHE_ENABLED=true
CACHE_TTL=300

# Security
HELMET_ENABLED=true

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_LIMIT_WINDOW_MS=900000
AUTH_LIMIT_MAX=5

# Google Cloud
GOOGLE_CLOUD_KEY_FILE=path/to/your/service-account-key.json
GOOGLE_CLOUD_PROJECT_ID=your-project-id

#stream messages
STREAM_API_KEY = your-stream-key
STREAM_API_SECRET = your-stream-secret
# LiveKit Redis Configuration (for agent communication)
# Use same Redis as LiveKit service for assessment Q&A flow
# This should point to your host machine Redis (same as BullMQ)
LIVEKIT_REDIS_HOST=localhost
LIVEKIT_REDIS_PORT=6379
LIVEKIT_REDIS_PASSWORD=
LIVEKIT_REDIS_USER=default
LIVEKIT_REDIS_DB=0  # Use DB 0 for LiveKit communication (BullMQ uses DB 1)
